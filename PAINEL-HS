-- ESP SYSTEM
--=========================================================
local esp = {}
local hologramas = {}

local function criarESP(player)
    if player == LocalPlayer then return end
    if esp[player] then return end

    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Config.CorESP
    box.Thickness = 1
    box.Filled = false
    box.Transparency = 1

    local healthBg = Drawing.new("Square")
    healthBg.Visible = false
    healthBg.Filled = true
    healthBg.Thickness = 0
    healthBg.Color = Color3.fromRGB(0, 0, 0)
    healthBg.Transparency = 0.7

    local health = Drawing.new("Square")
    health.Visible = false
    health.Filled = true
    health.Thickness = 0

    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = Config.CorESP
    line.Thickness = 1
    line.Transparency = 1

    esp[player] = {box = box, health = health, healthBg = healthBg, line = line}
end

local function removerESP(player)
    local t = esp[player]
    if not t then return end
    pcall(function() t.box:Remove() end)
    pcall(function() t.health:Remove() end)
    pcall(function() t.healthBg:Remove() end)
    pcall(function() t.line:Remove() end)
    esp[player] = nil
    if hologramas[player] then
        pcall(function() hologramas[player]:Destroy() end)
        hologramas[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do criarESP(p) end
Players.PlayerAdded:Connect(criarESP)
Players.PlayerRemoving:Connect(removerESP)

local function aplicarHolograma(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    if not hologramas[player] then
        local hl = Instance.new("Highlight")
        hl.Name = "JZNHolo"
        hl.FillColor = Config.CorHolograma
        hl.FillTransparency = 0.6
        hl.OutlineColor = Config.CorHolograma
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = char
        hl.Parent = char
        hologramas[player] = hl
    else
        hologramas[player].FillColor = Config.CorHolograma
        hologramas[player].OutlineColor = Config.CorHolograma
    end
end

local function removerHolograma(player)
    if hologramas[player] then
        pcall(function() hologramas[player]:Destroy() end)
        hologramas[player] = nil
    end
end

--=========================================================
-- LOOP ESP
--=========================================================
RunService.RenderStepped:Connect(function()
    atualizarFov()
    local camPos = Camera.CFrame.Position

    for player, t in pairs(esp) do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        local function esconderTudo()
            t.box.Visible = false
            t.health.Visible = false
            t.healthBg.Visible = false
            t.line.Visible = false
        end

        if Config.HologramaPlayer and hum and hum.Health > 0 then
            aplicarHolograma(player)
        else
            removerHolograma(player)
        end

        if hum and hrp and head and hum.Health > 0 then
            local dist3D = (hrp.Position - camPos).Magnitude
            if dist3D > Config.EspMaxDist then
                esconderTudo()
            else
                local topoPos, onTop = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local basePos, onBase = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                if onTop and onBase and topoPos.Z > 0 then
                    local altura = math.abs(basePos.Y - topoPos.Y)
                    local largura = altura / 2
                    local pct = hum.Health / hum.MaxHealth
                    local xEsq = topoPos.X - largura / 2
                    local yTop = topoPos.Y

                    if Config.EspBox then
                        t.box.Visible = true
                        t.box.Size = Vector2.new(largura, altura)
                        t.box.Position = Vector2.new(xEsq, yTop)
                        t.box.Color = Config.CorESP
                    else
                        t.box.Visible = false
                    end

                    if Config.EspLine then
                        t.line.Visible = true
                        t.line.From = Vector2.new(xEsq, yTop - 5)
                        t.line.To = Vector2.new(xEsq + largura, yTop - 5)
                        t.line.Color = Config.CorESP
                    else
                        t.line.Visible = false
                    end

                    if Config.EspHealthBar then
                        local barH = altura * pct
                        t.healthBg.Visible = true
                        t.healthBg.Size = Vector2.new(3, altura)
                        t.healthBg.Position = Vector2.new(xEsq - 5.5, yTop)
                        t.health.Visible = true
                        t.health.Size = Vector2.new(2, barH)
                        t.health.Position = Vector2.new(xEsq - 5, yTop + (altura - barH))
                        t.health.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
                    else
                        t.health.Visible = false
                        t.healthBg.Visible = false
                    end
                else
                    esconderTudo()
                end
            end
        else
            esconderTudo()
        end
    end
end)

