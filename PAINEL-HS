        TituloFino.Position = UDim2.new(0, input.Position.X - offsetTitulo.X, 0, input.Position.Y - offsetTitulo.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if arrastandoTitulo and not moveuTitulo then
            Main.Visible = true
            TituloFino.Visible = false
        end
        arrastandoTitulo = false
    end
end)

