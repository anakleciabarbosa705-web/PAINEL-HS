-- AIMBOT
--=========================================================
local function pegarAlvo()
    local centro = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local melhor, menorDist = nil, math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local bone = char and char:FindFirstChild("Head")
            if bone and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(bone.Position)
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - centro).Magnitude
                    if dist <= Config.TamanhoFov and dist < menorDist then
                        menorDist = dist
                        melhor = bone
                    end
                end
            end
        end
    end
    return melhor
end

local function aimbotLoop()
    if not Config.AimLock then
        checkCircle.Visible = false
        return
    end

    local alvo = pegarAlvo()
    if not alvo then
        checkCircle.Visible = false
        return
    end

    Camera.CFrame = CFrame.new(Camera.CFrame.Position, alvo.Position)

    local pos, onScreen = Camera:WorldToViewportPoint(alvo.Position)
    if onScreen and pos.Z > 0 then
        checkCircle.Visible = true
        checkCircle.Position = Vector2.new(pos.X, pos.Y)
        checkCircle.Radius = 22
    else
        checkCircle.Visible = false
    end
end

RunService:BindToRenderStep("JZNAimbot", Enum.RenderPriority.Camera.Value + 1, aimbotLoop)

