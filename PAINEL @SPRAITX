-- ==================== AIMBOT ====================
local function PegaAlvo()
    local melhor = nil
    local menorDist = math.huge
    local centro = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        local ch = pl.Character; if not ch then continue end
        local ponto = PegarPontoAlvo(ch)
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not (ponto and hum) or hum.Health <= 0 then continue end

        if Config.CheckVisible then
            local _, onScreen = Camera:WorldToViewportPoint(ponto.Position)
            if not onScreen then continue end
        end

        local pos, onScreen = Camera:WorldToViewportPoint(ponto.Position)
        if not onScreen or pos.Z <= 0 then continue end

        local dist = (Vector2.new(pos.X, pos.Y) - centro).Magnitude
        if dist < menorDist and dist <= Config.FovRadius then
            menorDist = dist
            melhor = ponto
        end
    end
    return melhor
end

-- ==================== AIMBOT RAGE (CORRIGIDO) ====================
-- Usa BindToRenderStep com prioridade alta pra sobrescrever o jogo
RunService:BindToRenderStep("MouraAimbotRage", Enum.RenderPriority.Camera.Value + 1, function()
    if not Config.AimbotRage then return end
    Camera = workspace.CurrentCamera
    if not Camera then return end

    local alvo = PegaAlvo()
    if not alvo then return end

    -- Mira direto no ponto do alvo
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, alvo.Position)
end)

