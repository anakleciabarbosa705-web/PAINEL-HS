-- ==================== FUNÇÃO: PEGAR PONTO DO ALVO ====================
local function PegarPontoAlvo(char)
    if Config.AimbotAlvo == "Cabeça" then
        return char:FindFirstChild("Head")
    elseif Config.AimbotAlvo == "Peito" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
    return char:FindFirstChild("Head")
end

-- ==================== ESP ====================
local espCache = {}

local function CriarESP()
    local box = Drawing.new("Square"); box.Thickness = 1; box.Filled = false; box.Visible = false
    local line = Drawing.new("Line"); line.Thickness = 1; line.Visible = false
    local lineTop = Drawing.new("Line"); lineTop.Thickness = 2; lineTop.Visible = false
    local healthBg = Drawing.new("Square"); healthBg.Filled = true; healthBg.Visible = false
    local health = Drawing.new("Square"); health.Filled = true; health.Visible = false
    local weapon = Drawing.new("Text"); weapon.Size = 12; weapon.Center = true
    weapon.Outline = true; weapon.Visible = false
    local skel = {}
    for i = 1, 15 do
        local ln = Drawing.new("Line")
        ln.Thickness = 1; ln.Visible = false
        skel[i] = ln
    end
    return {box=box, line=line, lineTop=lineTop, healthBg=healthBg,
            health=health, weapon=weapon, skel=skel}
end

local function RemoverESP(e)
    for _, o in pairs(e) do
        if type(o) == "table" then
            for _, o2 in pairs(o) do pcall(function() o2:Remove() end) end
        else pcall(function() o:Remove() end) end
    end
end

local R15Bones = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"},
    {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"},
    {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"},
    {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"},
    {"RightLowerLeg","RightFoot"},
}
local R6Bones = {
    {"Head","Torso"}, {"Torso","Left Arm"}, {"Torso","Right Arm"},
    {"Torso","Left Leg"}, {"Torso","Right Leg"},
}

RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    if not Camera then return end
    local vivos = {}
    if not Config.Esp then
        for pl, e in pairs(espCache) do RemoverESP(e); espCache[pl] = nil end
        return
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        local ch = pl.Character; if not ch then continue end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        local head = ch:FindFirstChild("Head")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not (hrp and head and hum) or hum.Health <= 0 then continue end
        local headP, headOn = Camera:WorldToViewportPoint(head.Position)
        local feetP, feetOn = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        if not headOn or not feetOn or headP.Z <= 0 then continue end
        local e = espCache[pl]
        if not e then e = CriarESP(); espCache[pl] = e end
        vivos[pl] = true
        local altura = math.abs(headP.Y - feetP.Y) * 1.1
        local largura = altura * 0.65
        local x = headP.X - largura / 2
        local y = headP.Y

        e.box.Visible = Config.EspBox
        if Config.EspBox then
            e.box.Size = Vector2.new(largura, altura)
            e.box.Position = Vector2.new(x, y)
            e.box.Color = Config.CorEsp
        end
        e.line.Visible = Config.EspLine
        if Config.EspLine then
            e.line.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
            e.line.To = Vector2.new(headP.X, y)
            e.line.Color = Config.CorEsp
        end
        e.lineTop.Visible = Config.EspLineTop
        if Config.EspLineTop then
            local dy = -8
            if Config.EspTracerEstilo == "Em baixo" then dy = altura + 8
            elseif Config.EspTracerEstilo == "Meio" then dy = altura / 2 end
            e.lineTop.From = Vector2.new(x - 10, y + dy)
            e.lineTop.To = Vector2.new(x + largura + 10, y + dy)
            e.lineTop.Color = Config.CorEsp
        end
        e.healthBg.Visible = Config.EspHealth
        e.health.Visible = Config.EspHealth
        if Config.EspHealth then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barH = altura * pct
            local bx = x - 6
            e.healthBg.Size = Vector2.new(3, altura)
            e.healthBg.Position = Vector2.new(bx, y)
            e.healthBg.Color = Color3.fromRGB(40, 40, 40)
            e.health.Size = Vector2.new(3, barH)
            e.health.Position = Vector2.new(bx, y + (altura - barH))
            e.health.Color = Config.CorHealth
        end
        e.weapon.Visible = Config.EspWeapon
        if Config.EspWeapon then
            local arma = "Sem arma"
            for _, item in ipairs(ch:GetChildren()) do
                if item:IsA("Tool") then arma = item.Name; break end
            end
            e.weapon.Position = Vector2.new(headP.X, y + altura + 4)
            e.weapon.Text = arma
            e.weapon.Color = Color3.fromRGB(255, 220, 100)
        end
        local bonesLista = ch:FindFirstChild("UpperTorso") and R15Bones or R6Bones
        for i, s in ipairs(e.skel) do
            if Config.EspSkeleton and bonesLista[i] then
                local p1 = ch:FindFirstChild(bonesLista[i][1])
                local p2 = ch:FindFirstChild(bonesLista[i][2])
                if p1 and p2 then
                    local v1, on1 = Camera:WorldToViewportPoint(p1.Position)
                    local v2, on2 = Camera:WorldToViewportPoint(p2.Position)
                    if on1 and on2 and v1.Z > 0 and v2.Z > 0 then
                        s.From = Vector2.new(v1.X, v1.Y)
                        s.To = Vector2.new(v2.X, v2.Y)
                        s.Color = Config.CorEsp
                        s.Visible = true
                    else s.Visible = false end
                else s.Visible = false end
            else s.Visible = false end
        end
    end
    for pl, e in pairs(espCache) do
        if not vivos[pl] then RemoverESP(e); espCache[pl] = nil end
    end
end)

Players.PlayerRemoving:Connect(function(pl)
    local e = espCache[pl]
    if e then RemoverESP(e); espCache[pl] = nil end
end)

-- ==================== HOLOGRAMA ====================
local holoCache = {}

local function LimparHolo()
    for _, obj in pairs(holoCache) do
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
    end
    holoCache = {}
end

RunService.RenderStepped:Connect(function()
    if not Config.Holograma then
        if next(holoCache) ~= nil then LimparHolo() end
        return
    end

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        local ch = pl.Character
        if not ch then continue end

        if not holoCache[pl] then
            local highlight = Instance.new("Highlight")
            highlight.Name = "MouraHolograma"
            highlight.Adornee = ch
            highlight.FillColor = Config.CorHolograma
            highlight.OutlineColor = Config.CorHolograma
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = ch
            holoCache[pl] = {highlight = highlight}
        else
            local obj = holoCache[pl]
            if obj.highlight and obj.highlight.Parent then
                obj.highlight.FillColor = Config.CorHolograma
                obj.highlight.OutlineColor = Config.CorHolograma
                obj.highlight.Adornee = ch
            else
                holoCache[pl] = nil
            end
        end
    end

    for pl, obj in pairs(holoCache) do
        if not pl.Character or not pl.Parent then
            if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
            holoCache[pl] = nil
        end
    end
end)

Players.PlayerRemoving:Connect(function(pl)
    local obj = holoCache[pl]
    if obj and obj.highlight then pcall(function() obj.highlight:Destroy() end) end
    holoCache[pl] = nil
end)

