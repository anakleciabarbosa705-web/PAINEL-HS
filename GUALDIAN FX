-- ============================================
-- 🛡️ GUARDIAN RFX - v1 (Painel Azul, ESP Branco)
-- ============================================
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
local RunService = game:GetService("RunService")
local Players    = game:GetService("Players")
local UIS        = game:GetService("UserInputService")
local LP         = Players.LocalPlayer
local Cam        = workspace.CurrentCamera

-- ==================== CONFIGURAÇÕES ====================
local CFG = {
    -- Aimbot
    AimRage = false,
    AimFov = false,
    FovSize = 150,
    AimPart = "Head",
    
    -- ESP
    EspEnabled = false,
    EspBoxOn = false,
    EspNameOn = false,
    EspEsqOn = false,
    EspLineOn = false,
    EspThick = 1,
    
    -- Rage
    InfJump = false,
    SpeedHack = false,
    SpinBot = false,
    SpinSpeed = 15,
    
    -- Cores
    CorPainel = Color3.fromRGB(0, 150, 255), -- Azul Neon para o painel
    CorESP = Color3.fromRGB(255, 255, 255),   -- Branco para o ESP e FOV
}

-- ==================== MENU PRINCIPAL ====================
local mainWindow = nil
local counterFrame, counterLabel

function loadScript()
    if mainWindow then mainWindow:Destroy() end

    -- Tema Azul Neon
    WindUI:AddTheme({
        Name = "GuardianNeon", 
        Accent = CFG.CorPainel, 
        Background = Color3.fromRGB(10, 12, 18), -- Fundo escuro
        Outline = CFG.CorPainel,
        Text = Color3.fromRGB(230, 240, 255), 
        Placeholder = Color3.fromRGB(100, 130, 180),
        Button = Color3.fromRGB(20, 30, 45), 
        Icon = CFG.CorPainel,
    })
    WindUI:SetTheme("GuardianNeon")

    -- Janela Menor
    mainWindow = WindUI:CreateWindow({
        Title = "🛡️ GUARDIAN RFX", 
        SubTitle = "v1.0",
        Icon = "shield", 
        Theme = "GuardianNeon", 
        ToggleKey = Enum.KeyCode.Minus,
        Size = UDim2.fromOffset(420, 260),
    })

    -- ==================== ABAS ====================
    -- ABA AIMBOT
    local T1 = mainWindow:Tab({Title = "Aimbot", Icon = "crosshair"})
    T1:Toggle({Title = "Aimbot Rage", Default = CFG.AimRage, Callback = function(v) CFG.AimRage = v end})
    T1:Toggle({Title = "Círculo FOV", Default = CFG.AimFov, Callback = function(v) CFG.AimFov = v end})
    T1:Slider({Title = "Tamanho FOV", Value = {Min = 50, Max = 600, Default = CFG.FovSize}, Callback = function(v) CFG.FovSize = v end})
    T1:Dropdown({Title = "Parte do Alvo", Values = {"Head", "Chest", "Neck"}, Default = CFG.AimPart, Callback = function(v) CFG.AimPart = v end})

    -- ABA ESP
    local T2 = mainWindow:Tab({Title = "ESP", Icon = "eye"})
    T2:Toggle({Title = "Ativar ESP", Default = CFG.EspEnabled, Callback = function(v) CFG.EspEnabled = v end})
    T2:Toggle({Title = "ESP Line", Default = CFG.EspLineOn, Callback = function(v) CFG.EspLineOn = v end})
    T2:Toggle({Title = "ESP Box", Default = CFG.EspBoxOn, Callback = function(v) CFG.EspBoxOn = v end})
    T2:Toggle({Title = "ESP Name", Default = CFG.EspNameOn, Callback = function(v) CFG.EspNameOn = v end})
    T2:Toggle({Title = "ESP Esqueleto", Default = CFG.EspEsqOn, Callback = function(v) CFG.EspEsqOn = v end})
    T2:Slider({Title = "Espessura", Value = {Min = 1, Max = 5, Default = CFG.EspThick}, Callback = function(v) CFG.EspThick = v end})

    -- ABA RAGE
    local T3 = mainWindow:Tab({Title = "Rage", Icon = "zap"})
    T3:Toggle({Title = "Spin Bot", Default = CFG.SpinBot, Callback = function(v) CFG.SpinBot = v end})
    T3:Slider({Title = "Velocidade do Spin (1-15)", Value = {Min = 1, Max = 15, Default = CFG.SpinSpeed}, Callback = function(v) CFG.SpinSpeed = v end})
    T3:Toggle({Title = "Speed 2x", Default = CFG.SpeedHack, Callback = function(v) CFG.SpeedHack = v end})
    T3:Toggle({Title = "Infinite Jump", Default = CFG.InfJump, Callback = function(v) CFG.InfJump = v end})

    -- ==================== LÓGICA ====================
    -- FOV Branco
    local fov = Drawing.new("Circle")
    fov.Thickness = 1
    fov.NumSides = 60
    fov.Filled = false
    fov.Color = CFG.CorESP

    local function getPart(ch)
        if not ch then return nil end
        if CFG.AimPart == "Head" then return ch:FindFirstChild("Head") end
        if CFG.AimPart == "Chest" then return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") end
        if CFG.AimPart == "Neck" then return ch:FindFirstChild("Neck") or ch:FindFirstChild("Head") end
        return ch:FindFirstChild("Head")
    end

    local function isEnemy(pl)
        if pl == LP then return false end
        local h = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
        return h and h.Health > 0
    end

    -- AIMBOT
    RunService:BindToRenderStep("GuardianAim", Enum.RenderPriority.Camera.Value + 1, function()
        if CFG.AimFov and CFG.AimRage then
            fov.Visible = true
            fov.Position = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
            fov.Radius = CFG.FovSize
        else
            fov.Visible = false
        end

        if not CFG.AimRage then 
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true end
            return 
        end

        local centro = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
        local best, bd = nil, math.huge

        for _, pl in ipairs(Players:GetPlayers()) do
            if isEnemy(pl) then
                local ch = pl.Character
                local part = getPart(ch)
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if part and hum and hum.Health > 0 then
                    local sp, on = Cam:WorldToViewportPoint(part.Position)
                    if on and sp.Z > 0 then
                        local d = (Vector2.new(sp.X, sp.Y) - centro).Magnitude
                        if d < bd and d <= CFG.FovSize then 
                            bd = d
                            best = part 
                        end
                    end
                end
            end
        end

        if best then
            local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if h then h.AutoRotate = false end
            -- Trava Câmera
            local lookPos = best.Position
            local myPos = Cam.CFrame.Position
            local direction = (lookPos - myPos).Unit
            Cam.CFrame = CFrame.new(myPos, myPos + direction)
        end
    end)

    -- ESP Branco
    local espData = {}
    local function getEsp(pl)
        if not espData[pl] then
            local d = { box = Drawing.new("Square"), nameTag = Drawing.new("Text"), line = Drawing.new("Line"), lines = {} }
            for i=1,14 do d.lines[i] = Drawing.new("Line") end
            espData[pl] = d
        end
        return espData[pl]
    end
    local function clearEsp(pl)
        local d = espData[pl]; if not d then return end
        for _, obj in pairs(d) do
            if type(obj) == "table" then for _, l in ipairs(obj) do l:Remove() end
            elseif obj.Remove then obj:Remove() end
        end
        espData[pl] = nil
    end
    Players.PlayerRemoving:Connect(clearEsp)

    local function bonePos(ch, name)
        local b = ch:FindFirstChild(name, true)
        if b and b:IsA("BasePart") then return b.Position end
    end

    RunService.RenderStepped:Connect(function()
        local cor = CFG.CorESP; local th = CFG.EspThick; local master = CFG.EspEnabled
        local marcados = 0

        for _, pl in ipairs(Players:GetPlayers()) do
            if pl == LP or not isEnemy(pl) or not master then
                if espData[pl] then clearEsp(pl) end; continue
            end

            local ch = pl.Character; local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart"); local head = ch and ch:FindFirstChild("Head")
            local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

            if not (ch and hum and hrp and head and hum.Health > 0 and myHRP) then
                if espData[pl] then clearEsp(pl) end; continue
            end

            marcados = marcados + 1
            local d = getEsp(pl)
            local headV, onHead = Cam:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
            local hrpV, onHrp = Cam:WorldToViewportPoint(hrp.Position)

            if CFG.EspBoxOn and onHead and onHrp then
                local alt = math.abs(hrpV.Y - headV.Y) * 2.2; local larg = alt * 0.6
                d.box.Size = Vector2.new(larg, alt); d.box.Position = Vector2.new(hrpV.X - larg/2, headV.Y - alt*0.2)
                d.box.Color = cor; d.box.Thickness = th; d.box.Visible = true
            else d.box.Visible = false end

            if CFG.EspNameOn and onHead then
                d.nameTag.Text = pl.Name; d.nameTag.Position = Vector2.new(headV.X - 20, headV.Y - 25)
                d.nameTag.Size = 14; d.nameTag.Color = cor; d.nameTag.Center = true; d.nameTag.Outline = true; d.nameTag.Visible = true
            else d.nameTag.Visible = false end

            if CFG.EspLineOn and onHrp then
                d.line.From = Vector2.new(Cam.ViewportSize.X/2, 0); d.line.To = Vector2.new(hrpV.X, hrpV.Y)
                d.line.Color = cor; d.line.Thickness = th; d.line.Visible = true
            else d.line.Visible = false end

            local pares = {
                {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
                {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"LowerTorso","LeftUpperLeg"},
                {"LeftUpperLeg","LeftLowerLeg"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},
            }
            if not ch:FindFirstChild("UpperTorso") then
                pares = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}
            end
            for i, l in ipairs(d.lines) do
                local par = pares[i]
                if CFG.EspEsqOn and par then
                    local a, b = bonePos(ch, par[1]), bonePos(ch, par[2])
                    if a and b then
                        local av, aOn = Cam:WorldToViewportPoint(a); local bv, bOn = Cam:WorldToViewportPoint(b)
                        if aOn and bOn and av.Z > 0 and bv.Z > 0 then
                            l.From, l.To = Vector2.new(av.X, av.Y), Vector2.new(bv.X, bv.Y); l.Color, l.Thickness, l.Visible = cor, th, true
                        else l.Visible = false end
                    else l.Visible = false end
                else l.Visible = false end
            end
        end
        if counterLabel then
            if marcados > 0 then counterLabel.Text = "👤 " .. marcados else counterLabel.Text = "👤 0" end
        end
    end)

    -- RAGE / MODS
    RunService.RenderStepped:Connect(function(dt)
        local ch = LP.Character
        if ch then
            local hrp = ch:FindFirstChild("HumanoidRootPart"); local hum = ch:FindFirstChildOfClass("Humanoid")
            if CFG.SpinBot and hrp and hum then
                hum.AutoRotate = false
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(CFG.SpinSpeed * 45 * dt), 0)
            end
            if hum then
                if CFG.SpeedHack then hum.WalkSpeed = 32 elseif hum.WalkSpeed == 32 then hum.WalkSpeed = 16 end
            end
        end
    end)

    UIS.JumpRequest:Connect(function()
        if CFG.InfJump then
            local ch = LP.Character; local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    pcall(function() WindUI:Notify({Title = "GUARDIAN RFX", Content = "Carregado! Créditos: @spraitx | @carlox_7🟢", Duration = 5}) end)
end

-- ==================== CONTADOR NO TOPO ====================
local counterGui = Instance.new("ScreenGui")
counterGui.Name = "GuardianCounter"; counterGui.ResetOnSpawn = false; counterGui.Parent = game:GetService("CoreGui")
counterFrame = Instance.new("Frame")
counterFrame.Size = UDim2.new(0, 50, 0, 22); counterFrame.Position = UDim2.new(0.5, -25, 0, 5)
counterFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0); counterFrame.BackgroundTransparency = 0.2
counterFrame.BorderSizePixel = 0; counterFrame.Visible = true; counterFrame.Parent = counterGui
Instance.new("UICorner", counterFrame).CornerRadius = UDim.new(0, 4)
local counterStroke = Instance.new("UIStroke", counterFrame)
counterStroke.Color = CFG.CorPainel; counterStroke.Thickness = 1.5
counterLabel = Instance.new("TextLabel")
counterLabel.Size = UDim2.new(1, 0, 1, 0); counterLabel.BackgroundTransparency = 1
counterLabel.TextColor3 = CFG.CorPainel; counterLabel.Font = Enum.Font.GothamBold
counterLabel.TextSize = 11; counterLabel.Text = "👤 0"; counterLabel.Parent = counterFrame

-- Inicia o script diretamente (sem Key)
loadScript()
