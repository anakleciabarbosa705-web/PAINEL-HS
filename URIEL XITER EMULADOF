        if idx > #options then idx = 1 end
        btn.Text = options[idx] .. " ▼"
        callback(options[idx])
    end)
end

local function CreateSlider(parent, text, min, max, default, yPos, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -8, 0, 28)
    frame.Position = UDim2.new(0, 4, 0, yPos)
    frame.BackgroundTransparency = 1
    frame.Parent = parent
    frame.ZIndex = 16
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 0, 12)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = CorTexto
    lbl.Font = Fonte
    lbl.TextSize = 9
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame
    lbl.ZIndex = 17
    
    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0.3, 0, 0, 12)
    val.Position = UDim2.new(0.7, 0, 0, 0)
    val.BackgroundTransparency = 1
    val.Text = tostring(default)
    val.TextColor3 = CorVermelhoVivo
    val.Font = Fonte
    val.TextSize = 9
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = frame
    val.ZIndex = 17
    
    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(1, 0, 0, 3)
    barBg.Position = UDim2.new(0, 0, 0, 15)
    barBg.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    barBg.Parent = frame
    barBg.ZIndex = 17
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
    fill.BackgroundColor3 = CorVermelho
    fill.Parent = barBg
    fill.ZIndex = 18
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local dragging = false
    barBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pct = math.clamp((input.Position.X - barBg.AbsolutePosition.X)/barBg.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            local v = math.floor(min + (max-min)*pct)
            val.Text = tostring(v)
            callback(v)
        end
    end)
end

