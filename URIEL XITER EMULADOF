    btn.Size = UDim2.new(0, 60, 0, 16)
    btn.Position = UDim2.new(1, -65, 0.5, -8)
    btn.BackgroundColor3 = CorFundo
    btn.Text = options[1] .. " ▼"
    btn.TextColor3 = CorTexto
    btn.Font = Fonte
    btn.TextSize = 8
    btn.Parent = frame
