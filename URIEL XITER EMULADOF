                        h.FillTransparency = 0.3; h.OutlineTransparency = 0
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Parent = item
                    end
                    h.FillColor = C.CorHoloArma
                    h.OutlineColor = C.CorHoloArma
                else
                    if h then h:Destroy() end
                end
            end
        end
    end
end)

