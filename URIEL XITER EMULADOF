    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = CorTexto
    label.Font = Fonte
    label.TextSize = 9
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    label.ZIndex = 17
    
    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 14, 0, 14)
    box.Position = UDim2.new(1, -20, 0.5, -7)
    box.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    box.Parent = frame
    box.ZIndex = 17
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 3)
    
    local check = Instance.new("TextLabel")
    check.Size = UDim2.new(1, 0, 1, 0)
    check.BackgroundTransparency = 1
    check.Text = "✓"
    check.TextColor3 = Color3.new(1,1,1)
    check.Font = FonteBold
    check.TextSize = 9
    check.Visible = default or false
    check.Parent = box
    check.ZIndex = 18
    
    if default then box.BackgroundColor3 = CorVerde end
    
    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = frame
    click.ZIndex = 19
    
    local state = default or false
    click.MouseButton1Click:Connect(function()
        state = not state
        check.Visible = state
        box.BackgroundColor3 = state and CorVerde or Color3.fromRGB(60, 60, 60)
        callback(state)
    end)
end

