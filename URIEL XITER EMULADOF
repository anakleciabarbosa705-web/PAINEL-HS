-- ==================== PEGAR ALVO ====================
local function PegarAlvo()
    local melhor, menorDist = nil, math.huge
    local centro = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        local ch = pl.Character; if not ch then continue end
        local ponto
        if C.Alvo == "Head" then ponto = ch:FindFirstChild("Head")
        elseif C.Alvo == "Torso" then ponto = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
        elseif C.Alvo == "Pescoço" then ponto = ch:FindFirstChild("Head") or ch:FindFirstChild("UpperTorso") end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not (ponto and hum) or hum.Health <= 0 then continue end
        local pos, on = Camera:WorldToViewportPoint(ponto.Position)
        if not on or pos.Z <= 0 then continue end
        local d = (Vector2.new(pos.X, pos.Y) - centro).Magnitude
        if d < menorDist and d <= C.FovRadius then menorDist = d; melhor = ponto end
    end
    return melhor
end

