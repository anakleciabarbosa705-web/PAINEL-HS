RunService:BindToRenderStep("UrielAimbot", Enum.RenderPriority.Camera.Value + 1, function()
    if not C.AimbotRage then return end
    local alvo = PegarAlvo()
    if not alvo then return end
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, alvo.Position)
end)

-- ==================== HOLOGRAMA PLAYER ====================
local holoCache = {}
RunService.RenderStepped:Connect(function()
    if not C.HologramaPlayer then
        for _, obj in pairs(holoCache) do
            if obj.h then pcall(function() obj.h:Destroy() end) end
        end
        holoCache = {}
        return
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        local ch = pl.Character; if not ch then continue end
        if not holoCache[pl] then
            local h = Instance.new("Highlight")
            h.Name = "UrielHolo"; h.Adornee = ch
            h.FillColor = C.CorHoloPlayer; h.OutlineColor = C.CorHoloPlayer
            h.FillTransparency = 0.5; h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = ch
            holoCache[pl] = {h = h}
        else
            local obj = holoCache[pl]
            if obj.h and obj.h.Parent then
                obj.h.FillColor = C.CorHoloPlayer
                obj.h.OutlineColor = C.CorHoloPlayer
                obj.h.Adornee = ch
            else holoCache[pl] = nil end
        end
    end
end)

-- ==================== HOLOGRAMA ARMA ====================
RunService.RenderStepped:Connect(function()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        local ch = pl.Character; if not ch then continue end
        for _, item in ipairs(ch:GetChildren()) do
            if item:IsA("Tool") then
