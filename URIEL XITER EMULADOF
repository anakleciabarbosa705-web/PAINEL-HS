local function CreateNavBtn(text, yPos, pageName)
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -10, 0, 26)
    bg.Position = UDim2.new(0, 5, 0, yPos)
    bg.BackgroundColor3 = CorFundo
    bg.Parent = Sidebar
    bg.ZIndex = 13
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 4)
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = CorTexto
    lbl.Font = FonteBold
    lbl.TextSize = 9
    lbl.Parent = bg
    lbl.ZIndex = 14
    
    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = bg
    click.ZIndex = 15
    
    click.MouseButton1Click:Connect(function()
        for _, child in ipairs(Sidebar:GetChildren()) do
            if child:IsA("Frame") and child:FindFirstChild("TextLabel") then
                child.BackgroundColor3 = CorFundo
                child.TextLabel.TextColor3 = CorTexto
            end
        end
        bg.BackgroundColor3 = CorVermelho
        lbl.TextColor3 = Color3.new(1,1,1)
        for _, p in pairs(Pages) do p.Visible = false end
        if Pages[pageName] then Pages[pageName].Visible = true end
    end)
    return bg
end

