-- ==================== ESP ====================
local espCache = {}

local function CriarESP()
    local box = Drawing.new("Square"); box.Thickness = 1; box.Filled = false; box.Visible = false
    local line = Drawing.new("Line"); line.Thickness = 1; line.Visible = false
    local snap = Drawing.new("Line"); snap.Thickness = 1; snap.Visible = false
    local hBg = Drawing.new("Square"); hBg.Filled = true; hBg.Visible = false
    local h = Drawing.new("Square"); h.Filled = true; h.Visible = false
    local nome = Drawing.new("Text"); nome.Size = 13; nome.Center = true; nome.Outline = true; nome.Visible = false
    local dist = Drawing.new("Text"); dist.Size = 12; dist.Center = true; dist.Outline = true; dist.Visible = false
    local skel = {}
    for i = 1, 15 do
        local ln = Drawing.new("Line"); ln.Thickness = 1; ln.Visible = false
        skel[i] = ln
    end
    return { box=box, line=line, snap=snap, hBg=hBg, h=h, nome=nome, dist=dist, skel=skel }
end

local function RemoverESP(e)
    for _, o in pairs(e) do
        if type(o) == "table" then
            for _, o2 in pairs(o) do pcall(function() o2:Remove() end) end
        else pcall(function() o:Remove() end) end
    end
end

local R15Bones = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"}, {"UpperTorso","LeftUpperArm"},
    {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"}, {"UpperTorso","RightUpperArm"},
    {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"}, {"LowerTorso","LeftUpperLeg"},
    {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"}, {"LowerTorso","RightUpperLeg"},
    {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
}
local R6Bones = {
    {"Head","Torso"}, {"Torso","Left Arm"}, {"Torso","Right Arm"}, {"Torso","Left Leg"}, {"Torso","Right Leg"},
}

RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    if not Camera then return end

    local vivos = {}
    local ligado = C.EspAtivo and (C.EspBox or C.EspLinha or C.EspEsqueleto or C.EspHatbar or C.EspNome or C.EspDist or C.EspSnapLine)
    if not ligado then
        for pl, e in pairs(espCache) do RemoverESP(e); espCache[pl] = nil end
        return
    end

    local corAtual = C.RGB and CorRGB(hueEsp) or C.CorEsp

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        local ch = pl.Character; if not ch then continue end
        local hrp = ch:FindFirstChild("HumanoidRootPart"); local head = ch:FindFirstChild("Head")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not (hrp and head and hum) or hum.Health <= 0 then continue end

        local headP, headOn = Camera:WorldToViewportPoint(head.Position)
        local feetP, feetOn = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        if not headOn or not feetOn or headP.Z <= 0 then continue end

        local e = espCache[pl]
        if not e then e = CriarESP(); espCache[pl] = e end
        vivos[pl] = true
        local altura = math.abs(headP.Y - feetP.Y) * 1.1
        local largura = altura * 0.65
        local x = headP.X - largura / 2
        local y = headP.Y

        e.box.Visible = C.EspBox
        if C.EspBox then
            e.box.Size = Vector2.new(largura, altura)
            e.box.Position = Vector2.new(x, y)
            e.box.Color = corAtual
        end

        e.line.Visible = C.EspLinha
        if C.EspLinha then
            local fX, fY, tX, tY
            if C.EspLinhaEstilo == "Topo" then fX = Camera.ViewportSize.X / 2; fY = 0; tX = headP.X; tY = y
            elseif C.EspLinhaEstilo == "Meio" then fX = Camera.ViewportSize.X / 2; fY = Camera.ViewportSize.Y / 2; tX = headP.X; tY = y + altura / 2
            elseif C.EspLinhaEstilo == "Cima" then fX = headP.X; fY = y - 15; tX = headP.X; tY = y end
            e.line.From = Vector2.new(fX, fY); e.line.To = Vector2.new(tX, tY)
            e.line.Color = corAtual
        end

        e.snap.Visible = C.EspSnapLine
        if C.EspSnapLine then
            e.snap.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            e.snap.To = Vector2.new(headP.X, y + altura / 2)
            e.snap.Color = corAtual
        end

        e.hBg.Visible = C.EspHatbar; e.h.Visible = C.EspHatbar
        if C.EspHatbar then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barH = altura * pct
            local bx = x - 6
            e.hBg.Size = Vector2.new(3, altura); e.hBg.Position = Vector2.new(bx, y)
            e.hBg.Color = Color3.fromRGB(40,40,40)
            e.h.Size = Vector2.new(3, barH); e.h.Position = Vector2.new(bx, y + (altura - barH))
            e.h.Color = Color3.fromRGB(0,255,0)
        end

        e.nome.Visible = C.EspNome
        if C.EspNome then
            e.nome.Position = Vector2.new(headP.X, y - 18); e.nome.Text = pl.Name
            e.nome.Color = corAtual
        end

        e.dist.Visible = C.EspDist
        if C.EspDist then
            local d = 0
            if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                d = math.floor((LP.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
            end
            e.dist.Position = Vector2.new(headP.X, y + altura + 4)
            e.dist.Text = d .. "m"; e.dist.Color = corAtual
        end

        local bl = ch:FindFirstChild("UpperTorso") and R15Bones or R6Bones
        for i, sk in ipairs(e.skel) do
            if C.EspEsqueleto and bl[i] then
                local p1 = ch:FindFirstChild(bl[i][1]); local p2 = ch:FindFirstChild(bl[i][2])
                if p1 and p2 then
                    local v1, o1 = Camera:WorldToViewportPoint(p1.Position)
                    local v2, o2 = Camera:WorldToViewportPoint(p2.Position)
                    if o1 and o2 and v1.Z > 0 and v2.Z > 0 then
                        sk.From = Vector2.new(v1.X, v1.Y); sk.To = Vector2.new(v2.X, v2.Y)
                        sk.Color = corAtual; sk.Visible = true
                    else sk.Visible = false end
                else sk.Visible = false end
            else sk.Visible = false end
        end
    end
    for pl, e in pairs(espCache) do
        if not vivos[pl] then RemoverESP(e); espCache[pl] = nil end
    end
end)

Players.PlayerRemoving:Connect(function(pl)
    local e = espCache[pl]
    if e then RemoverESP(e); espCache[pl] = nil end
end)

