        Main.Position = UDim2.new(0, input.Position.X - offset.X, 0, input.Position.Y - offset.Y)
    end
end)

--=========================================================
-- ARRASTAR BOTÃO Δ
--=========================================================
local arrastandoDelta = false
local offsetDelta = Vector2.new()
local moveuDelta = false

BotaoDelta.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        arrastandoDelta = true
        moveuDelta = false
        offsetDelta = Vector2.new(input.Position.X - BotaoDelta.AbsolutePosition.X, input.Position.Y - BotaoDelta.AbsolutePosition.Y)
    end
end)

UIS.InputChanged:Connect(function(input)
    if arrastandoDelta and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local dx = math.abs(input.Position.X - (BotaoDelta.AbsolutePosition.X + offsetDelta.X))
        local dy = math.abs(input.Position.Y - (BotaoDelta.AbsolutePosition.Y + offsetDelta.Y))
        if dx > 5 or dy > 5 then moveuDelta = true end
        BotaoDelta.Position = UDim2.new(0, input.Position.X - offsetDelta.X, 0, input.Position.Y - offsetDelta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if arrastandoDelta and not moveuDelta then
            Main.Visible = not Main.Visible
            if Main.Visible then
                BotaoDelta.Visible = false
                Main.Position = UDim2.new(0.5, -210, 0.5, -160)
            else
                BotaoDelta.Visible = true
            end
        end
        arrastandoDelta = false
    end
end)

