local function mostrarAba(nome)
    for n, page in pairs(Paginas) do
        page.Visible = (n == nome)
    end
    for n, btn in pairs(AbasBtns) do
        if n == nome then
            btn.TextColor3 = COR_TOPO
        else
            btn.TextColor3 = COR_TEXTO_2
        end
    end
    for _, info in ipairs(abasInfo) do
        if info.nome == nome then
            Title.Text = string.upper(info.label)
            IconeTop.Text = info.icone
            break
        end
    end
end

