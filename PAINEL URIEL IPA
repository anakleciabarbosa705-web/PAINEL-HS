--=========================================================
-- ESP SYSTEM (corrigido)
--=========================================================
local esp = {}

local skeletonConexoes = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"UpperTorso", "RightUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LowerTorso", "RightUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
}

local function criarESP(player)
    if player == LocalPlayer then return end
    if esp[player] then return end

    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Config.CorESP
    box.Thickness = 1
    box.Filled = false
    box.Transparency = 1

    local healthBg = Drawing.new("Square")
    healthBg.Visible = false
    healthBg.Filled = true
    healthBg.Thickness = 0
    healthBg.Color = Color3.fromRGB(0, 0, 0)
    healthBg.Transparency = 0.7

    local health = Drawing.new("Square")
    health.Visible = false
    health.Filled = true
    health.Thickness = 0

    local nome = Drawing.new("Text")
    nome.Visible = false
    nome.Center = true
    nome.Outline = true
    nome.Font = Drawing.Fonts.UI
    nome.Color = Color3.fromRGB(255, 255, 255)
    nome.OutlineColor = Color3.fromRGB(0, 0, 0)

    local dist = Drawing.new("Text")
    dist.Visible = false
    dist.Center = true
    dist.Outline = true
    dist.Font = Drawing.Fonts.UI
    dist.Color = Color3.fromRGB(255, 255, 255)
    dist.OutlineColor = Color3.fromRGB(0, 0, 0)

    -- LINHA EM CIMA DA TELA (do topo até o player)
    local linha = Drawing.new("Line")
    linha.Visible = false
    linha.Color = Config.CorESP
    linha.Thickness = 2
    linha.Transparency = 1

    local skeleton = {}
    for i = 1, #skeletonConexoes do
        local skLine = Drawing.new("Line")
        skLine.Visible = false
        skLine.Color = Config.CorESP
        skLine.Thickness = 1
        skLine.Transparency = 1
        skeleton[i] = skLine
    end

    esp[player] = {
        box = box, health = health, healthBg = healthBg,
        nome = nome, dist = dist, linha = linha,
        skeleton = skeleton,
    }
end

local function removerESP(player)
    local t = esp[player]
    if not t then return end
    pcall(function() t.box:Remove() end)
    pcall(function() t.health:Remove() end)
    pcall(function() t.healthBg:Remove() end)
    pcall(function() t.nome:Remove() end)
    pcall(function() t.dist:Remove() end)
    pcall(function() t.linha:Remove() end)
    if t.skeleton then
        for _, l in ipairs(t.skeleton) do
            pcall(function() l:Remove() end)
        end
    end
    esp[player] = nil
end

for _, p in ipairs(Players:GetPlayers()) do criarESP(p) end
Players.PlayerAdded:Connect(criarESP)
Players.PlayerRemoving:Connect(removerESP)

local function pegarBone(char, nome)
    if not char then return nil end
    local bone = char:FindFirstChild(nome)
    if bone then return bone end
    if nome == "UpperTorso" or nome == "LowerTorso" then return char:FindFirstChild("Torso") end
    if nome == "LeftUpperArm" or nome == "LeftLowerArm" then return char:FindFirstChild("Left Arm") end
    if nome == "RightUpperArm" or nome == "RightLowerArm" then return char:FindFirstChild("Right Arm") end
    if nome == "LeftUpperLeg" or nome == "LeftLowerLeg" then return char:FindFirstChild("Left Leg") end
    if nome == "RightUpperLeg" or nome == "RightLowerLeg" then return char:FindFirstChild("Right Leg") end
    return nil
end

