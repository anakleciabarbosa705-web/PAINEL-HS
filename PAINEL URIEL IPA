-- CHECKBOX laranja com ✓ branco
local function criarCheckbox(parent, texto, padrao, callback, y)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -12, 0, 40)
    frame.Position = UDim2.new(0, 6, 0, y or 0)
    frame.BackgroundColor3 = COR_FUNDO_2
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.ZIndex = 28
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = texto
    label.TextColor3 = COR_TEXTO
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 29
    label.Parent = frame

    local box = Instance.new("TextButton")
    box.Size = UDim2.new(0, 28, 0, 28)
    box.Position = UDim2.new(1, -38, 0.5, -14)
    box.BackgroundColor3 = Color3.fromRGB(35, 30, 25)
    box.Text = ""
    box.AutoButtonColor = false
    box.Active = true
    box.ZIndex = 29
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

    local boxStroke = Instance.new("UIStroke", box)
    boxStroke.Color = Color3.fromRGB(60, 55, 50)
    boxStroke.Thickness = 2

    local check = Instance.new("TextLabel")
    check.Size = UDim2.new(1, 0, 1, 0)
    check.BackgroundTransparency = 1
    check.Text = "✓"
    check.TextColor3 = Color3.fromRGB(255, 255, 255)
    check.Font = Enum.Font.GothamBold
    check.TextSize = 18
    check.Visible = padrao or false
    check.ZIndex = 30
    check.Parent = box

    local estado = padrao or false
    if estado then
        box.BackgroundColor3 = COR_ON
        boxStroke.Color = COR_ON
    end

    box.MouseButton1Click:Connect(function()
        estado = not estado
        check.Visible = estado
        box.BackgroundColor3 = estado and COR_ON or Color3.fromRGB(35, 30, 25)
        boxStroke.Color = estado and COR_ON or Color3.fromRGB(60, 55, 50)
        if callback then callback(estado) end
    end)
    return frame
end

-- SLIDER
local function criarSlider(parent, texto, min, max, padrao, sufixo, callback, y, decimal)
    decimal = decimal or 0
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -12, 0, 58)
    frame.Position = UDim2.new(0, 6, 0, y or 0)
    frame.BackgroundColor3 = COR_FUNDO_2
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.ZIndex = 28
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -70, 0, 22)
    label.Position = UDim2.new(0, 14, 0, 6)
    label.BackgroundTransparency = 1
    label.Text = texto
    label.TextColor3 = COR_TEXTO
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 29
    label.Parent = frame

    local valorLabel = Instance.new("TextLabel")
    valorLabel.Size = UDim2.new(0, 70, 0, 22)
    valorLabel.Position = UDim2.new(1, -76, 0, 6)
    valorLabel.BackgroundTransparency = 1
    valorLabel.Text = (decimal > 0 and string.format("%.2f", padrao) or tostring(padrao)) .. (sufixo or "")
    valorLabel.TextColor3 = COR_TOPO
    valorLabel.Font = Enum.Font.GothamBold
    valorLabel.TextSize = 14
    valorLabel.TextXAlignment = Enum.TextXAlignment.Right
    valorLabel.ZIndex = 29
    valorLabel.Parent = frame

    local trilha = Instance.new("Frame")
    trilha.Size = UDim2.new(1, -28, 0, 6)
    trilha.Position = UDim2.new(0, 14, 0, 38)
    trilha.BackgroundColor3 = Color3.fromRGB(50, 44, 38)
    trilha.BorderSizePixel = 0
    trilha.ZIndex = 29
    trilha.Parent = frame
    Instance.new("UICorner", trilha).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((padrao - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = COR_TOPO
    fill.BorderSizePixel = 0
    fill.ZIndex = 29
    fill.Parent = trilha
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local bolinha = Instance.new("Frame")
    bolinha.Size = UDim2.new(0, 20, 0, 20)
    bolinha.Position = UDim2.new((padrao - min) / (max - min), -10, 0.5, -10)
    bolinha.BackgroundColor3 = COR_TOPO
    bolinha.BorderSizePixel = 0
    bolinha.ZIndex = 30
    bolinha.Parent = trilha
    Instance.new("UICorner", bolinha).CornerRadius = UDim.new(1, 0)
    local bolinhaStroke = Instance.new("UIStroke", bolinha)
    bolinhaStroke.Color = Color3.fromRGB(255, 255, 255)
    bolinhaStroke.Thickness = 2

    local hitbox = Instance.new("TextButton")
    hitbox.Size = UDim2.new(1, 0, 0, 30)
    hitbox.Position = UDim2.new(0, 0, 0, -12)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.Active = true
    hitbox.ZIndex = 30
    hitbox.Parent = trilha

    local arrastando = false
    local function atualizar(posX)
        local relX = math.clamp((posX - trilha.AbsolutePosition.X) / trilha.AbsoluteSize.X, 0, 1)
        local valor = min + (max - min) * relX
        if decimal > 0 then
            valor = math.floor(valor * (10^decimal)) / (10^decimal)
            valorLabel.Text = string.format("%.2f", valor) .. (sufixo or "")
        else
            valor = math.floor(valor)
            valorLabel.Text = tostring(valor) .. (sufixo or "")
        end
        fill.Size = UDim2.new(relX, 0, 1, 0)
        bolinha.Position = UDim2.new(relX, -10, 0.5, -10)
        if callback then callback(valor) end
    end

    hitbox.MouseButton1Down:Connect(function(x) arrastando = true; atualizar(x) end)
    hitbox.MouseMoved:Connect(function(x) if arrastando then atualizar(x) end end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            arrastando = false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if arrastando and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            atualizar(i.Position.X)
        end
    end)
    return frame
end

