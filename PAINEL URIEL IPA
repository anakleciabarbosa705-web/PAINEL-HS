local function criarDropdown(parent, texto, opcoes, padrao, callback, y)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -12, 0, 60)
    frame.Position = UDim2.new(0, 6, 0, y or 0)
    frame.BackgroundTransparency = 1
    frame.Active = true
    frame.ZIndex = 28
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 18)
    label.BackgroundTransparency = 1
    label.Text = texto
    label.TextColor3 = COR_TEXTO
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 29
    label.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.Position = UDim2.new(0, 0, 0, 20)
    btn.BackgroundColor3 = COR_FUNDO_2
    btn.Text = "  " .. padrao
    btn.TextColor3 = COR_TEXTO
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Active = true
    btn.ZIndex = 30
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local seta = Instance.new("TextLabel")
    seta.Size = UDim2.new(0, 28, 1, 0)
    seta.Position = UDim2.new(1, -30, 0, 0)
    seta.BackgroundTransparency = 1
    seta.Text = "v"
    seta.TextColor3 = COR_TOPO
    seta.Font = Enum.Font.GothamBold
    seta.TextSize = 14
    seta.ZIndex = 31
    seta.Parent = btn

    local lista = Instance.new("Frame")
    lista.Size = UDim2.new(1, 0, 0, #opcoes * 30)
    lista.Position = UDim2.new(0, 0, 1, 2)
    lista.BackgroundColor3 = COR_FUNDO
    lista.BorderSizePixel = 0
    lista.Visible = false
    lista.ZIndex = 50
    lista.Active = true
    lista.Parent = frame
    Instance.new("UICorner", lista).CornerRadius = UDim.new(0, 8)
    local listaLayout = Instance.new("UIListLayout", lista)
    listaLayout.Parent = lista

    for _, op in ipairs(opcoes) do
        local opt = Instance.new("TextButton")
        opt.Size = UDim2.new(1, 0, 0, 30)
        opt.BackgroundTransparency = 1
        opt.Text = op
        opt.TextColor3 = COR_TEXTO
        opt.Font = Enum.Font.GothamBold
        opt.TextSize = 12
        opt.ZIndex = 51
        opt.AutoButtonColor = false
        opt.Active = true
        opt.Parent = lista
        opt.MouseButton1Click:Connect(function()
            btn.Text = "  " .. op
            lista.Visible = false
            if callback then callback(op) end
        end)
    end

    btn.MouseButton1Click:Connect(function()
        lista.Visible = not lista.Visible
    end)
    return frame
end

