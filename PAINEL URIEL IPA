-- AIMBOT
--=========================================================
local function pegarOsso(char)
    if not char then return nil end
    if Config.Osso == "Cabeça" then return char:FindFirstChild("Head") end
    if Config.Osso == "Pescoço" then return char:FindFirstChild("Neck") or char:FindFirstChild("Head") end
    if Config.Osso == "Peito" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") end
    if Config.Osso == "Torso" then return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") end
    return char:FindFirstChild("Head")
end

local function pegarAlvo()
    local centro = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local melhor, menorDist = nil, math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local bone = pegarOsso(char)
            if bone and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(bone.Position)
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - centro).Magnitude
                    local distWorld = (bone.Position - Camera.CFrame.Position).Magnitude
                    if dist <= Config.FOV and distWorld <= Config.Distancia and dist < menorDist then
                        menorDist = dist
                        melhor = bone
                    end
                end
            end
        end
    end
    return melhor
end

RunService:BindToRenderStep("UrielIPAAimbot", Enum.RenderPriority.Camera.Value + 1, function()
    if not Config.Aimbot then return end
    local alvo = pegarAlvo()
    if not alvo then return end
    local alvoCF = CFrame.new(Camera.CFrame.Position, alvo.Position)
    Camera.CFrame = Camera.CFrame:Lerp(alvoCF, Config.Velocidade)
end)

