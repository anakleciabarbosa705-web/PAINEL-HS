--=========================================================
-- LOOP ESP
--=========================================================
RunService.RenderStepped:Connect(function()
    -- FOV
    local vs = Camera.ViewportSize
    fovCircle.Position = Vector2.new(vs.X / 2, vs.Y / 2)
    fovCircle.Radius = Config.FOV
    fovCircle.Visible = Config.MostrarFOV

    local camPos = Camera.CFrame.Position

    for player, t in pairs(esp) do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        if Config.AtivarESP and hum and hrp and head and hum.Health > 0 then
            local dist3D = (hrp.Position - camPos).Magnitude
            if dist3D > Config.AlcanceESP then
                t.box.Visible = false
                t.health.Visible = false
                t.healthBg.Visible = false
                t.nome.Visible = false
                t.dist.Visible = false
                t.linha.Visible = false
                for _, l in ipairs(t.skeleton) do l.Visible = false end
            else
                local topoPos, onTop = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local basePos, onBase = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                if onTop and onBase and topoPos.Z > 0 then
                    local altura = math.abs(basePos.Y - topoPos.Y)
                    local largura = altura / 2
                    local pct = hum.Health / hum.MaxHealth
                    local xEsq = topoPos.X - largura / 2
                    local yTop = topoPos.Y

                    -- BOX
                    if Config.Caixas then
                        t.box.Visible = true
                        t.box.Size = Vector2.new(largura, altura)
                        t.box.Position = Vector2.new(xEsq, yTop)
                        t.box.Thickness = Config.Espessura
                        t.box.Color = Config.CorESP
                    else
                        t.box.Visible = false
                    end

                    -- HEALTHBAR
                    if Config.Vida then
                        local barH = altura * pct
                        t.healthBg.Visible = true
                        t.healthBg.Size = Vector2.new(3, altura)
                        t.healthBg.Position = Vector2.new(xEsq - 5.5, yTop)
                        t.health.Visible = true
                        t.health.Size = Vector2.new(2, barH)
                        t.health.Position = Vector2.new(xEsq - 5, yTop + (altura - barH))
                        t.health.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
                    else
                        t.health.Visible = false
                        t.healthBg.Visible = false
                    end

                    -- NOME
                    if Config.Nomes then
                        t.nome.Visible = true
                        t.nome.Text = player.Name
                        t.nome.Size = 13
                        t.nome.Position = Vector2.new(topoPos.X, yTop - 16)
                    else
                        t.nome.Visible = false
                    end

                    -- DISTÂNCIA
                    if Config.Distancia2 then
                        t.dist.Visible = true
                        t.dist.Text = math.floor(dist3D) .. "m"
                        t.dist.Size = 12
                        t.dist.Position = Vector2.new(topoPos.X, yTop + altura + 4)
                    else
                        t.dist.Visible = false
                    end

                    -- LINHA (de CIMA DA TELA até o player - igual última imagem)
                    if Config.Linhas then
                        t.linha.Visible = true
                        t.linha.From = Vector2.new(topoPos.X, 0)         -- TOPO da tela
                        t.linha.To = Vector2.new(topoPos.X, yTop)        -- cabeça do player
                        t.linha.Color = Config.CorESP
                        t.linha.Thickness = Config.Espessura + 1
                    else
                        t.linha.Visible = false
                    end

                    -- SKELETON
                    if Config.Esqueleto then
                        for i, conexao in ipairs(skeletonConexoes) do
                            local boneA = pegarBone(char, conexao[1])
                            local boneB = pegarBone(char, conexao[2])
                            local skLine = t.skeleton[i]
                            if boneA and boneB then
                                local posA, onA = Camera:WorldToViewportPoint(boneA.Position)
                                local posB, onB = Camera:WorldToViewportPoint(boneB.Position)
                                if onA and onB and posA.Z > 0 and posB.Z > 0 then
                                    skLine.Visible = true
                                    skLine.From = Vector2.new(posA.X, posA.Y)
                                    skLine.To = Vector2.new(posB.X, posB.Y)
                                    skLine.Thickness = Config.Espessura
                                    skLine.Color = Config.CorESP
                                else
                                    skLine.Visible = false
                                end
                            else
                                skLine.Visible = false
                            end
                        end
                    else
                        for _, l in ipairs(t.skeleton) do l.Visible = false end
                    end
                else
                    t.box.Visible = false
                    t.health.Visible = false
                    t.healthBg.Visible = false
                    t.nome.Visible = false
                    t.dist.Visible = false
                    t.linha.Visible = false
                    for _, l in ipairs(t.skeleton) do l.Visible = false end
                end
            end
        else
            t.box.Visible = false
            t.health.Visible = false
            t.healthBg.Visible = false
            t.nome.Visible = false
            t.dist.Visible = false
            t.linha.Visible = false
            for _, l in ipairs(t.skeleton) do l.Visible = false end
        end
    end
end)

